# Evaluation image: adds Java (for pycocoevalcap's METEOR scorer and
# tokenizer) and evaluation dependencies on top of the app image.
FROM rag-image-captioning:local

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-eval.txt .
RUN pip install --no-cache-dir -r requirements-eval.txt
COPY . .
